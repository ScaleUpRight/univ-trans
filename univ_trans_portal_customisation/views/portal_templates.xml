<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Lists the documents filed under the order's Documents folder.

        Restricted to members of the viewer group: an ordinary customer looking at
        their own order must not start seeing the contents of its document folder,
        which can hold internal paperwork.

        `report_type` is checked so the block renders on the portal page but not in
        the printed/PDF rendering of the same template.
    -->
    <template id="portal_order_documents" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="uv_documents"
               t-value="sale_order.sudo().documents_file_ids.filtered(lambda d: d.type == 'binary')
                        if request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')
                        else request.env['documents.document']"/>
            <div id="uv_order_documents" class="row" t-if="uv_documents and (not report_type or report_type == 'html')">
                <div class="col-12 mb-4">
                    <h5 class="mb-1">Documents</h5>
                    <hr class="mt-1 mb-2"/>
                    <ul class="list-unstyled mb-0">
                        <li t-foreach="uv_documents" t-as="uv_doc" class="mb-1">
                            <a t-attf-href="/my/orders/#{sale_order.id}/document/#{uv_doc.id}">
                                <i class="fa fa-download me-1" role="img" aria-label="Download"/><span t-out="uv_doc.name"/>
                            </a>
                            <small class="text-muted ms-1" t-if="uv_doc.file_size">
                                (<span t-out="uv_doc.file_size" t-options='{"widget": "binary_size"}'/>)
                            </small>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
    </template>

    <!--
        Trim the portal home for order viewers: they are an internal employee looking
        across orders, not a customer, so invoices, addresses and connection settings
        are noise.  "Your Orders" is deliberately left in place.

        priority 99 so this is applied after sale (20) and account (30) have inserted
        their cards - the nodes must already be in the arch for these xpaths to match.
    -->
    <template id="portal_my_home_order_viewer" inherit_id="portal.portal_my_home" priority="99">
        <!-- Addresses + Connection & Security both live in this row -->
        <xpath expr="//div[@id='portal_common_category']" position="attributes">
            <attribute name="t-if">not request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')</attribute>
        </xpath>
        <!-- Your Invoices, without touching Your Orders in the same row -->
        <xpath expr="//div[@id='portal_client_category']//t[@t-set='title'][text()='Your Invoices']/.." position="attributes">
            <attribute name="t-if">not request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')</attribute>
        </xpath>
    </template>

    <!--
        A Customer column on the orders list: an ordinary portal user only ever sees
        their own orders, so stock Odoo has no such column, but a viewer looking
        across every customer needs it - and it is one of the search fields, so the
        list should show what is being searched.  `orders` is already a sudo
        recordset in sale's controller, so partner_id reads fine.
    -->
    <template id="portal_my_orders_customer" inherit_id="sale.portal_my_orders" priority="99">
        <xpath expr="//thead/tr/th[1]" position="after">
            <th t-if="request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')">
                Customer
            </th>
        </xpath>
        <xpath expr="//t[@t-foreach='orders']/tr/td[1]" position="after">
            <td t-if="request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')">
                <span t-out="order.partner_id.display_name"/>
            </td>
        </xpath>
    </template>

    <!-- ================= Opportunities ================= -->

    <template id="portal_my_home_opportunity" inherit_id="portal.portal_my_home" priority="98">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry"
               t-if="request.env.user.has_group('univ_trans_portal_customisation.group_order_viewer')">
                <t t-set="icon" t-value="'/univ_trans_portal_customisation/static/src/img/portal-opportunity.svg'"/>
                <t t-set="title">Opportunities</t>
                <t t-set="url" t-value="'/my/opportunities'"/>
                <t t-set="text">Browse all opportunities</t>
                <t t-set="placeholder_count" t-value="'opportunity_count'"/>
            </t>
        </div>
    </template>

    <template id="portal_breadcrumbs_opportunity" inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'opportunity'"
                t-attf-class="breadcrumb-item #{'active ' if not lead else ''}">
                <a t-if="lead" t-attf-href="/my/opportunities?{{ keep_query() }}">Opportunities</a>
                <t t-else="">Opportunities</t>
            </li>
            <li t-if="page_name == 'opportunity' and lead" class="breadcrumb-item active">
                <t t-out="lead.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_opportunities" name="My Opportunities">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Opportunities</t>
            </t>

            <div t-if="not opportunities" class="alert alert-warning" role="alert">
                There are currently no opportunities.
            </div>

            <t t-if="opportunities" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Opportunity ID</th>
                        <th>Opportunity</th>
                        <th>Customer</th>
                        <th>Stage</th>
                        <th class="text-end">Created</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="opportunities" t-as="opp">
                        <td><span t-out="opp.opportunity_file_id"/></td>
                        <td>
                            <a t-attf-href="/my/opportunities/#{opp.id}"><span t-out="opp.name"/></a>
                        </td>
                        <td><span t-out="opp.partner_id.display_name"/></td>
                        <td><span t-out="opp.stage_id.name"/></td>
                        <td class="text-end">
                            <span t-field="opp.create_date" t-options='{"widget": "date"}'/>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <!--
        Sections come from the controller, which derives them from the combined form
        arch, so this template stays agnostic about which fields exist.  Values are
        pre-formatted in Python; `t-out` renders Markup (html fields) unescaped and
        escapes everything else.
    -->
    <template id="portal_opportunity_page" name="Opportunity">
        <t t-call="portal.portal_layout">
            <div class="row mb-3">
                <div class="col-12">
                    <h4 class="mb-0"><span t-out="lead.name"/></h4>
                </div>
            </div>

            <div t-if="documents" class="mb-4">
                <h5 class="mb-1">Documents</h5>
                <hr class="mt-1 mb-2"/>
                <ul class="list-unstyled mb-0">
                    <li t-foreach="documents" t-as="uv_doc" class="mb-1">
                        <a t-attf-href="/my/opportunities/#{lead.id}/document/#{uv_doc.id}">
                            <i class="fa fa-download me-1" role="img" aria-label="Download"/>
                            <span t-out="uv_doc.name"/>
                        </a>
                    </li>
                </ul>
            </div>

            <t t-foreach="sections" t-as="uv_section">
                <div class="mb-4">
                    <h5 t-if="uv_section[0]" class="mb-1"><span t-out="uv_section[0]"/></h5>
                    <hr class="mt-1 mb-2"/>
                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr t-foreach="uv_section[1]" t-as="uv_row">
                                <th class="ps-0 text-muted fw-normal align-top" style="width: 30%;">
                                    <span t-out="uv_row[0]"/>
                                </th>
                                <td class="text-wrap"><span t-out="uv_row[1]"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

</odoo>
