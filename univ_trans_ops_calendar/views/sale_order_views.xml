<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_ops_calendar" model="ir.ui.view">
        <field name="name">sale.order.form.ops.calendar</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_ops_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        invisible="x_ops_task_count == 0">
                    <field name="x_ops_task_count" widget="statinfo" string="Ops Job"/>
                </button>
            </div>
            <page name="other_information" position="after">
                <page string="Operations" name="ops_calendar">
                    <group string="Calendar Settings">
                        <field name="x_ops_region"/>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>
