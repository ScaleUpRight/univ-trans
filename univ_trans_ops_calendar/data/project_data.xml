<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Projects -->
        <record id="project_israel_ops" model="project.project">
            <field name="name">Israel Operations</field>
            <field name="privacy_visibility">employees</field>
        </record>

        <record id="project_international" model="project.project">
            <field name="name">International</field>
            <field name="privacy_visibility">employees</field>
        </record>

        <!-- Stages (shared across both projects) -->
        <record id="stage_planned" model="project.task.type">
            <field name="name">Planned</field>
            <field name="sequence">10</field>
            <field name="project_ids" eval="[(4, ref('project_israel_ops')), (4, ref('project_international'))]"/>
        </record>

        <record id="stage_confirmed" model="project.task.type">
            <field name="name">Confirmed</field>
            <field name="sequence">20</field>
            <field name="project_ids" eval="[(4, ref('project_israel_ops')), (4, ref('project_international'))]"/>
        </record>

        <record id="stage_in_progress" model="project.task.type">
            <field name="name">In Progress</field>
            <field name="sequence">30</field>
            <field name="project_ids" eval="[(4, ref('project_israel_ops')), (4, ref('project_international'))]"/>
        </record>

        <record id="stage_completed" model="project.task.type">
            <field name="name">Completed</field>
            <field name="sequence">40</field>
            <field name="project_ids" eval="[(4, ref('project_israel_ops')), (4, ref('project_international'))]"/>
        </record>

    </data>
</odoo>
