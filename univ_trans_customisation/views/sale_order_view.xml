<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_documents" model="ir.ui.view">
        <field name="name">sale.order.form.documents</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <div colspan="2" class="d-flex">
                    <div>
                        <label for="documents_folder_id" string="Document Folder"/>
                        <field name="documents_folder_id" class="oe_inline mx-1" readonly="1"
                               options="{'no_open': True}" invisible="not documents_folder_id"/>
                    </div>
                    <button class="btn btn-link pt-0"
                            type="object"
                            invisible="not documents_folder_id"
                            name="action_open_documents">
                        <i class="fa fa-external-link"/>
                        Open
                    </button>
                </div>

                <field name="documents_file_ids" widget="many2many_tags" readonly="1"/>
                <field name="opportunity_id" readonly="1"/>
                <field name="is_opportunity_fields_editable" invisible="1"/>
            </xpath>

        </field>
    </record>

    <!-- 2026-06-08: per-quote origin/destination CITY, editable on the quote
         (Ilan, WhatsApp 2026-03-24). Placed right after the matching *_country
         fields, which are injected by the Studio view (priority 160), so this
         view uses a higher priority (200) to guarantee the anchors exist. -->
    <record id="view_sale_order_form_inherit_city" model="ir.ui.view">
        <field name="name">sale.order.form.shipment.city</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <field name="x_studio_moving_from_country" position="after">
                <field name="x_studio_moving_from_city" string="Moving From City"
                       force_save="1" readonly="not is_opportunity_fields_editable"/>
            </field>
            <field name="x_studio_move_to_country" position="after">
                <field name="x_studio_move_to_city" string="Move To City"
                       force_save="1" readonly="not is_opportunity_fields_editable"/>
            </field>
        </field>
    </record>
</odoo>
