<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_inherit_file_id" model="ir.ui.view">
        <field name="name">crm.lead.form.file.id</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="opportunity_file_id" readonly="1"/>
                <field name="documents_folder_id" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_crm_lead_tree_inherit_file_id" model="ir.ui.view">
        <field name="name">crm.lead.tree.file.id</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <!-- Add after Opportunity name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="opportunity_file_id"/>
            </xpath>
        </field>
    </record>
</odoo>
