<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_documents" model="ir.ui.view">
        <field name="name">account.move.form.documents</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date']" position="after">
                <div colspan="2" class="d-flex">
                    <div>
                        <label for="documents_folder_id" string="Document Folder"/>
                        <field name="documents_folder_id" class="oe_inline mx-1" readonly="1"
                               options="{'no_open': True}" invisible="not documents_folder_id"/>
                    </div>
                    <button class="btn btn-link pt-0"
                            type="object"
                            invisible="not documents_folder_id"
                            name="action_open_documents">
                        <i class="fa fa-external-link"/>
                        Open
                    </button>
                </div>
                <field name="documents_file_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
